# Copy this file to .env and fill in values before starting the stack.
# Never commit .env to version control.

# Compose project and volume namespace. Unset, it defaults to the directory name
# (qna74 in a qna74 checkout, app on the VM in /srv/app). Set it only to match the
# prefix of your existing <project>_mysql_data volume: any other name starts on an
# empty database.
# COMPOSE_PROJECT_NAME=qna74

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me_app

# --- Backend ---
# Async MySQL URL (used by SQLAlchemy + Alembic)
DATABASE_URL=mysql+asyncmy://app_user:change_me_app@mysql:3306/qna

# Redis
REDIS_URL=redis://redis:6379/0

# JWT RS256 keys — generate with:
#   python backend/scripts/generate_keys.py
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_ENCODED_PEM
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_ENCODED_PEM

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:8080,http://localhost:8000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Frontend URL (used in OAuth2 callback redirect)
# In development use port 8080; in production use your deployed origin
FRONTEND_URL=http://localhost:8080

# Required for /auth/oauth2-callback (campus SSO login) to work at all.
# The X-Auth-Request-User / X-Auth-Request-Email headers that endpoint
# trusts are otherwise trivial to spoof by anyone with network access to
# this service — leave this unset in development (the dev netid login on
# each app's login page doesn't need it) and only set it once a real
# OAuth2 reverse proxy is deployed in front of this service, configured
# with the same secret and set to strip any client-supplied copy of it.
OAUTH2_PROXY_SHARED_SECRET=

# Bootstrap admin account — created automatically on first startup.
# Once an admin user exists these values are ignored and can be removed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin

# Course grader account — DO NOT CHANGE OR REMOVE, locally or on your deployed VM.
# Startup creates an admin user named "grader" from this value (base64 of a
# bcrypt hash). Only course staff know the password behind it; they use it to
# grade your deployed application. It is safe to have in this file.
GRADER_PASSWORD_HASH=JDJiJDEyJFpIc1E1ci5DOUZBa3Y3VnhQaG9UZk9EU1VQRklLRy5KQ0xDTVpmbU9Kb2pPbXpHc0FTd0Rt

# --- RAG (docs/design-rag.md §4.3.2) ---
# false during harness runs and gte ingestion: new questions then get no AI answer
RAG_LIVE_ENABLED=true
OLLAMA_URL=http://ollama:11434
INFINITY_URL=http://infinity:7997
CHROMA_HOST=chroma
CHROMA_PORT=8000
RAG_DEFAULT_PROFILE=sliding-window
# Initial value; replaced by the threshold calibration (design §11.2)
RAG_DEFAULT_THRESHOLD=0.50
RAG_DEFAULT_MODEL=qwen2.5:1.5b
RAG_TOP_K=4
RAG_LIVE_GENERATION_TIMEOUT_S=120
RAG_LIVE_LOCK_WAIT_S=600
RAG_MAX_PENDING_PER_COURSE=3
RAG_COMPARE_LOCK_WAIT_S=30
RAG_COMPARE_EMBED_TIMEOUT_S=15
RAG_COMPARE_GENERATION_TIMEOUT_S=100
RAG_INGEST_EMBED_TIMEOUT_S=120
UPLOAD_DIR=/data/uploads
CLONE_TMP_DIR=/tmp
MAX_UPLOAD_MB=20
MAX_ZIP_MB=50
MAX_FETCH_MB=10

# GitLab access for repository and URL resources: read_repository + read_api.
# A runtime secret: set it only in each machine's .env, never in git or CI variables.
GITLAB_HOST=git.doit.wisc.edu
GITLAB_TOKEN=

# Compose-only: models pulled by the one-shot ollama-pull service. Must include
# every generation_model in eval/configs.json.
OLLAMA_PULL_MODELS=qwen2.5:1.5b qwen2.5:3b

# Compose-only: embedding models served by Infinity, ';'-separated, with one
# INFINITY_BATCH_SIZE entry per model. gte-Qwen2 needs about 6 GB of RAM; on a
# laptop with little Docker memory, drop it locally:
#   INFINITY_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2;BAAI/bge-small-en-v1.5;
#   INFINITY_BATCH_SIZE=32;32;
INFINITY_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2;BAAI/bge-small-en-v1.5;Alibaba-NLP/gte-Qwen2-1.5B-instruct;
INFINITY_BATCH_SIZE=32;32;4;
